NODE_ENV=development
PORT=5000

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

COOKIE_SECRET=change-me-cookie-secret
COOKIE_EXP=15

DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=root
DB_PASSWORD=root

# Optional single URL instead of DB_* above:
# DATABASE_URL=postgresql://root:root@localhost:5432/mydb

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
# Or: REDIS_URL=redis://localhost:6379

# Optional: expose Scalar (/reference) and OpenAPI JSON (/api/v1/doc) in production
# ENABLE_API_DOCS=true
