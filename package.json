{
  "name": "boilerplate",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "commit": "npx gitmoji -c",
    "dev:tsc": "tsc --watch",
    "watch:serve": "tsnd src/server.ts --rs",
    "dev:server": "nodemon dist/server.js",
    "dev": "concurrently --kill-others \"npm run dev:tsc\" && \"npm run dev:server\"",
    "serve": "node dist/server.js",
    "kill-process": "kill $(lsof -ti:8080)",
    "build": "tsc",
    "format": "prettier --write \"./src/**/*.{js,ts,json}\"",
    "check-types": "tsc --pretty --noEmit",
    "check-format": "prettier --check \"./src/**/*.{js,ts,json}\"",
    "check-lint": "eslint . --ext ts --ext js",
    "prepare": "husky install"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.17.3",
    "jsonwebtoken": "^8.5.1",
    "morgan": "^1.10.0",
    "pg": "^8.7.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.17.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^16.2.3",
    "@commitlint/config-conventional": "^16.2.1",
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/morgan": "^1.9.3",
    "@types/node": "^17.0.22",
    "@types/sequelize": "^4.28.11",
    "@typescript-eslint/eslint-plugin": "^5.16.0",
    "@typescript-eslint/parser": "^5.16.0",
    "commitlint-config-gitmoji": "^2.2.5",
    "concurrently": "^7.0.0",
    "eslint": "^8.11.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-typescript": "^2.7.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-prettier": "^4.0.0",
    "gitmoji-cli": "^4.11.0",
    "husky": "^7.0.0",
    "prettier": "^2.6.0",
    "sequelize-cli": "^6.4.1",
    "ts-node-dev": "^1.1.8"
  }
}
