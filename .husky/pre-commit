#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "Biome, types, and build pre-commit checks"

npm exec biome check . ||
(
  echo "Biome check failed. Run: npm run check:fix"
  exit 1
)

npm run check-types ||
(
  echo "Typecheck failed."
  exit 1
)

npm run build ||
(
  echo "Build failed."
  exit 1
)

echo "Pre-commit checks passed."
