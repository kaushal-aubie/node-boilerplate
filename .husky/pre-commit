#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "Biome, types, and build pre-commit checks"

pnpm exec biome check . ||
(
  echo "Biome check failed. Run: pnpm run check:fix"
  exit 1
)

pnpm run check-types ||
(
  echo "Typecheck failed."
  exit 1
)

pnpm run build ||
(
  echo "Build failed."
  exit 1
)

echo "Pre-commit checks passed."
